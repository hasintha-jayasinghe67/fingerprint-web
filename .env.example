# Base URL of the backend API server. All /api/* requests made by the app are
# proxied to <BACKEND_API_URL>/api/* via a rewrite in next.config.ts.
#
# Defaults to http://localhost:8088 when unset (local development).
# Set this to your deployed backend origin, e.g.:
#   BACKEND_API_URL=https://api.example.com
BACKEND_API_URL=http://localhost:8088
