# Base URL of the backend API server. The app calls <BACKEND_API_URL>/api/*
# directly from the browser, so this must be reachable from the user's browser
# and the backend must allow CORS requests from the frontend origin.
#
# REQUIRED: it has no default, so the app refuses to start without it.
# It is inlined into the client bundle at build time, so it must be set when
# the app is built (Vercel/Netlify: build environment variable).
# Copy this file to .env.local and set the value for local development, e.g.:
#   BACKEND_API_URL=http://localhost:8088
BACKEND_API_URL=http://localhost:8088

# ---------------------------------------------------------------------------
# Supabase Auth (required for login / user management)
# ---------------------------------------------------------------------------
# Project URL and publishable (anon) key — safe for the browser; RLS-bound.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-anon-key

# Service role key — SERVER / scripts ONLY. Never prefix with NEXT_PUBLIC_.
# Used by /api/users* and scripts/create-superuser.mjs.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional alias used by create-superuser.mjs (falls back to NEXT_PUBLIC_SUPABASE_URL).
# SUPABASE_URL=https://YOUR_PROJECT.supabase.co
